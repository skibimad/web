    <!-- Theme initialization script (runs before page renders to prevent flash) -->
    <script>
        (function() {
            const stored = localStorage.getItem('theme');
            // Default to dark theme if no preference stored
            let theme = 'dark';
            if (stored === 'light') {
                theme = 'light';
            }
            // Note: system theme option has been removed, defaults to dark
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
