<?php
$sections = $this('sections');
$sectionsConfig = $this('sectionsConfig');
?>
<div class="admin-header">
    <h1 class="admin-title">Manage Landing Page</h1>
</div>

<div class="form-container">
    <div class="form-card">
        <form method="post" action="/admin/landing/update" class="landing-form">
            
            <?php foreach ($sectionsConfig as $sectionKey => $sectionConfig): ?>
            <div class="form-section">
                <h2 class="section-header"><?= htmlspecialchars($sectionConfig['title']) ?></h2>
                
                <?php foreach ($sectionConfig['fields'] as $fieldKey => $fieldConfig): ?>
                    <?php
                    $currentValue = isset($sections[$sectionKey][$fieldKey])
                        ? $sections[$sectionKey][$fieldKey]['value']
                        : '';
                    $fieldId = $sectionKey . '_' . $fieldKey;
                    $fieldName = "landing[{$sectionKey}][{$fieldKey}]";
                    ?>
                    <div class="form-group">
                        <label for="<?= $fieldId ?>"><?= htmlspecialchars($fieldConfig['label']) ?></label>
                        
                        <?php if ($fieldConfig['type'] === 'rich'): ?>
                            <textarea 
                                id="<?= $fieldId ?>" 
                                name="<?= $fieldName ?>" 
                                class="summernote-editor"
                                placeholder="Enter <?= htmlspecialchars(strtolower($fieldConfig['label'])) ?>..."
                            ><?= htmlspecialchars($currentValue) ?></textarea>
                        <?php else: ?>
                            <input 
                                type="text" 
                                id="<?= $fieldId ?>" 
                                name="<?= $fieldName ?>" 
                                value="<?= htmlspecialchars($currentValue) ?>"
                                placeholder="Enter <?= htmlspecialchars(strtolower($fieldConfig['label'])) ?>..."
                            >
                        <?php endif; ?>
                    </div>
                <?php endforeach; ?>
            </div>
            <?php endforeach; ?>

            <button type="submit" class="submit-btn">
                Save Changes
            </button>
        </form>
    </div>
</div>
