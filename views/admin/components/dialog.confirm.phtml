<div class="dialog-confirm">
    <div class="dialog-content">
        <p class="dialog-message"></p>
        <div class="dialog-actions">
            <button type="button" class="btn btn-secondary dialog-cancel">Cancel</button>
            <button type="button" class="btn btn-primary dialog-confirm-btn">Confirm</button>
        </div>
    </div>
</div>

<script>
    const dialog = document.querySelector('.dialog-confirm');
    const dialogMessage = dialog.querySelector('.dialog-message');
    const dialogCancel = dialog.querySelector('.dialog-cancel');
    const dialogConfirmBtn = dialog.querySelector('.dialog-confirm-btn');

    function showDialog(message, onConfirm) {
        dialogMessage.textContent = message;
        dialog.classList.add('show');

        function confirmHandler() {
            onConfirm();
            closeDialog();
        }

        function closeDialog() {
            dialog.classList.remove('show');
            dialogConfirmBtn.removeEventListener('click', confirmHandler);
            dialogCancel.removeEventListener('click', closeDialog);
        }

        dialogConfirmBtn.addEventListener('click', confirmHandler);
        dialogCancel.addEventListener('click', closeDialog);
    }

    // Expose the confirm function globally
    window.FSX = window.FSX || {};
    window.FSX.confirm = showDialog;
</script>