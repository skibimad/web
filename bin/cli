#!/usr/bin/env php
<?php
/**
 * Skibidi Madness CLI Application
 * 
 * Usage: php bin/cli <command> [arguments]
 * 
 * Available commands:
 *   db:setup                 - Set up the database schema
 *   db:migrate               - Run pending migrations
 *   db:demo                  - Load demo data
 *   resource:external:update - Update local copies of external CSS/JS libraries
 *   help                     - Show help message
 *   list                     - List all commands
 */

// Ensure we're running from the command line
if (php_sapi_name() !== 'cli') {
    exit('This script can only be run from the command line.');
}

// Load the autoloader
require_once __DIR__ . '/../vendor/autoload.php';

// Initialize the application
\App\Core\Helper\Resource::init(__DIR__ . '/..');

// Create CLI application
$app = new \App\Cli\Application();

// Register commands
$app->registerCommand(new \App\Cli\Command\DbSetupCommand());
$app->registerCommand(new \App\Cli\Command\DbMigrateCommand());
$app->registerCommand(new \App\Cli\Command\DbDemoCommand());
$app->registerCommand(new \App\Cli\Command\ResourceExternalUpdateCommand());

// Run the application
exit($app->run($argv));
